{
  "name": "civ5-mod-manager",
  "productName": "Civilization V Mod Manager",
  "version": "0.1.0",
  "description": "Switch a Civilization V: Brave New World installation between vanilla and installed-file mods such as MiddleEarth.",
  "private": true,
  "main": "out/main/index.js",
  "author": "civ5me",
  "license": "UNLICENSED",
  "scripts": {
    "build:mod": "node scripts/build-mod.mjs",
    "payload": "node scripts/build-payload.mjs",
    "dev": "node scripts/build-mod.mjs && electron-vite dev",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "bundle": "electron-vite build",
    "build": "npm run build:mod && electron-vite build && electron-builder --win portable --x64 --publish never",
    "dist:linux": "npm run build:mod && electron-vite build && electron-builder --linux AppImage --x64 --publish never",
    "dist:dir": "node scripts/build-payload.mjs && electron-vite build && electron-builder --dir",
    "smoke": "electron-vite build && node scripts/smoke.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
