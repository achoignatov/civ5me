<?xml version="1.0" encoding="utf-8"?>
<Mod id="9f1a1884-17be-4f9f-bbbf-37143a130eb3" version="2">
  <Properties>
    <Name>Middle Earth True Start Location</Name>
    <Stability>Beta</Stability>
    <Teaser>Middle Earth Maps with True start locations, Semi-Random Resources, &amp; Dynamic City Naming</Teaser>
    <Description>Middle Earth True Start Location features two maps that aim to provide the best True Start Location experience possible for the civilizations from my main mod Middle Earth Civilizations. 

This mod would not be possible without Gedemon and FramedArchitecture giving me permission to use elements of their mods Yet (not) another Earth Maps Pack and Accurate Maps.

This mod requires:
Gods and Kings
Brave New World
Middle Earth Civilizations
Middle Earth City States
Middle Earth Only

Please see these mods workshop page for additional information.</Description>
    <Authors>Yenyang</Authors>
    <SpecialThanks>Gedemon, FramedArchitecture</SpecialThanks>
    <HideSetupGame>1</HideSetupGame>
    <AffectsSavedGames>1</AffectsSavedGames>
    <MinCompatibleSaveVersion>0</MinCompatibleSaveVersion>
    <SupportsSinglePlayer>1</SupportsSinglePlayer>
    <SupportsMultiplayer>1</SupportsMultiplayer>
    <SupportsHotSeat>1</SupportsHotSeat>
    <SupportsMac>1</SupportsMac>
    <ReloadAudioSystem>0</ReloadAudioSystem>
    <ReloadLandmarkSystem>0</ReloadLandmarkSystem>
    <ReloadStrategicViewSystem>0</ReloadStrategicViewSystem>
    <ReloadUnitSystem>0</ReloadUnitSystem>
  </Properties>
  <Dependencies>
    <Mod id="46830894-7582-4a69-8c5a-1837e053a9de" minversion="0" maxversion="999" title="Middle Earth City States" />
    <Mod id="65b7def1-337c-4f88-9f84-2fb2213417e6" minversion="2" maxversion="999" title="Middle Earth Only" />
  </Dependencies>
